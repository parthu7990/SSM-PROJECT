# ── Django Core ────────────────────────────────────────────
# Generate a strong secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*

# ── Database (PostgreSQL) ─────────────────────────────────
# Railway provides this automatically. For Vercel, use an
# external managed PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL=

# ── Cloudinary Media Storage (recommended on Vercel) ──────
# Vercel serverless filesystem is read-only & ephemeral.
# Use Cloudinary for persistent media/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ─────────────────────────────────────────────────
EMAIL_HOST_USER=info@pskfutureinnovation.com
EMAIL_HOST_PASSWORD=
ADMIN_EMAIL=info@pskfutureinnovation.com
DEFAULT_FROM_EMAIL=info@pskfutureinnovation.com

# ── CSRF Trusted Origins ──────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.railway.app,https://*.vercel.app

# ── Platform auto-domains (optional) ──────────────────────
# Railway
RAILWAY_PUBLIC_DOMAIN=

# Vercel (VERCEL and VERCEL_URL are auto-set by Vercel)
VERCEL=false
VERCEL_URL=
