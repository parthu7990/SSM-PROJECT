# ============================================================
# SSM Future Innovation FZE - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Django Core ---
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False

# Comma-separated list of allowed hosts
# Railway sets RAILWAY_PUBLIC_DOMAIN automatically, this is optional
ALLOWED_HOSTS=*

# --- Database ---
# Railway provides DATABASE_URL automatically when you add a Postgres service
# For local dev, leave empty to use SQLite
DATABASE_URL=

# --- Cloudinary (Media Storage) ---
# Recommended for production image storage (persistent across restarts)
# Leave empty to use local /media/ storage (NOT persistent on Railway)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@pskfutureinnovation.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@pskfutureinnovation.com
ADMIN_EMAIL=info@pskfutureinnovation.com

# --- CSRF Trusted Origins (comma-separated) ---
# Railway default domains are pre-configured; add your custom domain here
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.railway.app
